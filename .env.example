# =========================
# VABot 用户配置模板
# 使用方法：
# 1. 复制本文件为 .env
# 2. 按自己的保存目录和解析接口填写
# 3. 不要把 .env 上传到 GitHub
# =========================

# =========================
# 保存位置
# =========================

# Docker 部署必填：飞牛/NAS/服务器宿主机上的真实保存目录。
# 例子：
# VABOT_HOST_SAVE_DIR=/vol1/1000/Downloads/VABot
# VABOT_HOST_SAVE_DIR=/mnt/sata1/VABot
VABOT_HOST_SAVE_DIR=

# 容器内保存目录。Docker 用户通常保持 /creative 不动。
# 如果不使用 Docker、直接 python 运行，请改成你本机想保存的位置，例如 ./downloads。
CREATIVE_ROOT=/creative

# 可选：不填会自动使用 CREATIVE_ROOT/video、CREATIVE_ROOT/music、CREATIVE_ROOT/logs。
VIDEO_DIR=
MUSIC_DIR=
LOG_DIR=
RECORD_FILE=

REQUEST_TIMEOUT=30
KEEP_LIVE_RAW=false

# =========================
# 解析接口
# 本项目不提供、不内置任何私人解析接口。
# 请把你自己购买、部署或允许使用的接口填到下面。
# 不用的接口保持空白即可。
# =========================

# 抖音专用解析接口
DOUYIN_API=

# 小红书图文解析接口
XHSIMG_API=

# 通用短视频解析接口
SHORT_VIDEOS_API=

# 备用通用解析接口
SVPARSE_API=

# 音乐解析接口
QSMUSIC_API=

# 可选备用接口。没有就留空。
APICX_DOUYIN_LIVE_API=
APICX_XHS_API=

# 如果你的接口需要 key/token/auth，就在这里填；不需要就留空。
BUGPK_KEY=
APICX_TOKEN=
APICX_AUTH=

# =========================
# HTTP / OpenAI 兼容接口
# =========================
VABOT_HOST=0.0.0.0
VABOT_PORT=18088

# 强烈建议设置。设置后，请求需要带 Header：
# X-VABOT-Token: 你的token
# 或 Authorization: Bearer 你的token
VABOT_TOKEN=

VABOT_MODE_TIMEOUT_SECONDS=120
VABOT_SEND_TIMEOUT_SECONDS=20

# =========================
# 每天 60 秒看世界，可选
# 默认关闭，避免未配置微信通道时自动推送报错。
# =========================
VABOT_60S_ENABLED=false
VABOT_60S_TIMES=08:00,20:00
VABOT_60S_API=https://60s.viki.moe/v2/60s?encoding=text
TZ=Asia/Shanghai

# =========================
# OpenClaw / 微信通道，可选
# 不使用微信机器人时全部留空即可。
# =========================
OPENCLAW_WEIXIN_STATE_ROOT_HOST=
OPENCLAW_CONFIG_HOST=
VABOT_WEIXIN_STATE_ROOT=/openclaw-weixin
VABOT_OPENCLAW_CONFIG=/openclaw-config/openclaw.json
VABOT_WEIXIN_ACCOUNT_ID=
VABOT_WEIXIN_TO_USER_ID=
